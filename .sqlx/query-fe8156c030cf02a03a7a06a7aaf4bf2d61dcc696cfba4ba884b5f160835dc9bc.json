  "query": "\n        INSERT INTO economy_balances (guild_id, user_id, cash, bank)\n        VALUES ($1, $2, $3, 0)\n        ON CONFLICT (guild_id, user_id) DO UPDATE SET\n            cash = economy_balances.cash + EXCLUDED.cash\n        RETURNING guild_id, user_id, cash, bank\n        ",
