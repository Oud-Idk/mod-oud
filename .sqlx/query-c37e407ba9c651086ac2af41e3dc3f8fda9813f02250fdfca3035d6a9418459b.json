  "query": "\n        SELECT id, hub_url, topic, lease_expires_at\n        FROM feeds\n        WHERE feed_type = 'PUBSUBHUBBUB'\n          AND hub_url IS NOT NULL\n          AND topic IS NOT NULL\n          AND lease_expires_at IS NOT NULL\n          AND lease_expires_at < NOW() + INTERVAL '24 hours'\n        LIMIT 5\n        ",
