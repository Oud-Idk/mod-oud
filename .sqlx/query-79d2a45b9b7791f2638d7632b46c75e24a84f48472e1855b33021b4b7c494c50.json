{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT user_id, birth_month, birth_day, birth_year\n        FROM user_birthdays\n        WHERE (\n            (MAKE_DATE(EXTRACT(YEAR FROM CURRENT_DATE)::int, birth_month, birth_day) - CURRENT_DATE + 365) % 365\n        ) BETWEEN 0 AND $1\n        ORDER BY\n            ((MAKE_DATE(EXTRACT(YEAR FROM CURRENT_DATE)::int, birth_month, birth_day) - CURRENT_DATE + 365) % 365)\n        LIMIT 25\n        ",
