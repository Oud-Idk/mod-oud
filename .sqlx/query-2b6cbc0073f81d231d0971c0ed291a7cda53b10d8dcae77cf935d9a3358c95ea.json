  "query": "\n        SELECT\n            id,\n            channel_id,\n            message AS \"message: Json<MessageLayout>\",\n            r_type AS \"r_type: ReminderType\",\n            days_of_week,\n            time_start,\n            time_end,\n            interval_seconds,\n            timezone\n        FROM reminders\n        WHERE next_trigger_at <= $1 AND is_active = true\n        ORDER BY next_trigger_at ASC\n        LIMIT $2\n        ",
