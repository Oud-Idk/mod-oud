  "query": "\n        SELECT ub.user_id, ub.birth_year\n        FROM user_birthdays ub\n        WHERE ub.birth_month = $1\n          AND ub.birth_day = $2\n          AND NOT EXISTS (\n              SELECT 1 FROM birthday_logs bl\n              WHERE bl.guild_id = $3\n                AND bl.user_id = ub.user_id\n                AND bl.year_sent = $4\n          )\n        ",
