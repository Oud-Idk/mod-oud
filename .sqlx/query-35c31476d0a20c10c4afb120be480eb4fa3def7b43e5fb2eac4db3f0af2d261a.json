{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT guild_id, user_id, cash, bank\n        FROM economy_balances\n        WHERE guild_id = $1\n          AND (cash + bank) < $2\n        ORDER BY (cash + bank) DESC, user_id ASC\n        LIMIT $3\n        ",
