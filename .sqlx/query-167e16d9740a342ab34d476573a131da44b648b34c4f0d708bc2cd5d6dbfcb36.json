  "query": "\n        SELECT r.guild_id, r.channel_id, r.message_id, r.author_id, u.username AS author_name\n        FROM reported_messages r\n        LEFT JOIN discord_users u ON u.user_id = r.author_id\n        WHERE r.id = $1\n        ",
