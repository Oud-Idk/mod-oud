  "query": "\n        SELECT id, user_id, moderator_id, reason, created_at, is_active\n        FROM warns\n        WHERE guild_id = $1\n          AND reason ILIKE $2\n          AND ($3::BIGINT IS NULL OR user_id = $3)\n        ORDER BY id DESC\n        LIMIT 50\n        ",
