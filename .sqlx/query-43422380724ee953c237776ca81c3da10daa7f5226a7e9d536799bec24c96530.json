{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, url, last_polled_at\n        FROM feeds\n        WHERE feed_type = 'POLLING'\n          AND (\n            last_polled_at IS NULL\n            OR last_polled_at < NOW() - (interval_secs * INTERVAL '1 second')\n          )\n        ORDER BY last_polled_at NULLS FIRST\n        LIMIT 10\n        ",
